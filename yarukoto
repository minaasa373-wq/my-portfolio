<!DOCTYPE html>
<html lang="ja" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>タスク＆メモ - DoNote</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans JP"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Noto Sans JP', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }
        /* Checkbox animation */
        .task-checkbox:checked + .checkbox-custom {
            background-color: #10b981;
            border-color: #10b981;
        }
        .task-checkbox:checked + .checkbox-custom i {
            display: block;
        }
        /* Fade transitions */
        .fade-in {
            animation: fadeIn 0.25s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-full flex flex-col transition-colors duration-200">

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-30 bg-white/80 dark:bg-slate-800/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 px-4 lg:px-8 py-3">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
            <!-- Logo & Brand -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white shadow-md shadow-emerald-500/20">
                    <i class="fa-solid fa-check-double text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-tight text-slate-900 dark:text-white">DoNote</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">やること＆アイデア整理</p>
                </div>
            </div>

            <!-- Header Quick Stats & Theme Toggle -->
            <div class="flex items-center gap-3">
                <!-- Mini Progress Pill (Desktop) -->
                <div class="hidden md:flex items-center gap-3 bg-slate-100 dark:bg-slate-700/60 px-3 py-1.5 rounded-full text-xs">
                    <span class="text-slate-500 dark:text-slate-400">本日の進捗</span>
                    <div class="w-24 bg-slate-200 dark:bg-slate-600 rounded-full h-2 overflow-hidden">
                        <div id="headerProgressBar" class="bg-emerald-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                    <span id="headerProgressText" class="font-semibold text-emerald-600 dark:text-emerald-400">0%</span>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-tight text-slate-900 dark:text-white">DoNote</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">やること＆アイデア整理</p>
                </div>
            </div>

            <!-- Header Quick Stats & Theme Toggle -->
            <div class="flex items-center gap-3">
                <!-- Mini Progress Pill (Desktop) -->
                <div class="hidden md:flex items-center gap-3 bg-slate-100 dark:bg-slate-700/60 px-3 py-1.5 rounded-full text-xs">
                    <span class="text-slate-500 dark:text-slate-400">本日の進捗</span>
                    <div class="w-24 bg-slate-200 dark:bg-slate-600 rounded-full h-2 overflow-hidden">
                        <div id="headerProgressBar" class="bg-blue-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                    <span id="headerProgressText" class="font-semibold text-blue-600 dark:text-blue-400">0%</span>
                </div>

                <!-- Dark Mode Toggle Button -->
                <button id="themeToggleBtn" title="テーマ切り替え" class="p-2 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    <i class="fa-solid fa-moon dark:hidden text-lg"></i>
                    <i class="fa-solid fa-sun hidden dark:block text-lg text-amber-400"></i>
                </button>

                <!-- Data Backup / Settings Modal Trigger -->
                <button id="openSettingsBtn" title="設定・データ" class="p-2 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    <i class="fa-solid fa-gear text-lg"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <div class="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 lg:p-8 flex flex-col md:flex-row gap-6">

        <!-- Sidebar Navigation & Filters -->
        <aside class="w-full md:w-64 flex-shrink-0 space-y-6">
            <!-- New Item Buttons -->
            <div class="grid grid-cols-2 md:grid-cols-1 gap-2">
                <button id="openAddTaskModalBtn" class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 px-4 rounded-xl shadow-md shadow-emerald-500/20 transition active:scale-[0.98]">
                    <i class="fa-solid fa-plus"></i>
                    <span>タスクを追加</span>
                </button>
                <button id="openAddNoteModalBtn" class="w-full flex items-center justify-center gap-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-100 font-medium py-2.5 px-4 rounded-xl transition active:scale-[0.98]">
                    <i class="fa-solid fa-note-sticky"></i>
                    <span>メモを作成</span>
                </button>
            </div>

            <!-- View Switcher (Tasks vs Memos) -->
            <div class="bg-white dark:bg-slate-800 p-1.5 rounded-2xl border border-slate-200 dark:border-slate-700 flex">
                <button id="viewTasksTab" class="flex-1 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition bg-emerald-600 text-white shadow-sm">
                    <i class="fa-solid fa-list-check"></i>
                    <span>タスク</span>
                    <span id="activeTaskBadge" class="bg-white/20 text-white text-[10px] px-1.5 py-0.5 rounded-full">0</span>
                </button>
                <button id="viewNotesTab" class="flex-1 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                    <i class="fa-solid fa-sticky-note"></i>
                    <span>メモ帳</span>
                    <span id="activeNoteBadge" class="bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-[10px] px-1.5 py-0.5 rounded-full">0</span>
                </button>
            </div>

            <!-- Filter Options for Tasks Section -->
            <div id="taskFiltersSidebar" class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 space-y-4">
                <h2 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">フィルター</h2>
                
                <!-- Status Filter -->
                <div class="space-y-1">
                    <button data-filter="all" class="task-status-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-inbox w-4"></i>すべてのタスク</span>
                        <span id="countAllTasks" class="text-xs opacity-80">0</span>
                    </button>
                    <button data-filter="active" class="task-status-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                        <span class="flex items-center gap-2"><i class="fa-regular fa-circle w-4"></i>未完了</span>
                        <span id="countActiveTasks" class="text-xs opacity-80">0</span>
                    </button>
                    <button data-filter="today" class="task-status-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                        <span class="flex items-center gap-2"><i class="fa-regular fa-calendar-check w-4"></i>今日が期限</span>
                        <span id="countTodayTasks" class="text-xs opacity-80">0</span>
                    </button>
                    <button data-filter="completed" class="task-status-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-check w-4"></i>完了済み</span>
                        <span id="countCompletedTasks" class="text-xs opacity-80">0</span>
                    </button>
                </div>

                <hr class="border-slate-100 dark:border-slate-700">

                <!-- Category Filters -->
                <div>
                    <h3 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">カテゴリ</h3>
                    <div id="categoryFilterContainer" class="space-y-1">
                        <!-- Dynamic Categories -->
                    </div>
                </div>
            </div>

            <!-- Notes Filter Sidebar (hidden by default) -->
            <div id="noteFiltersSidebar" class="hidden bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 space-y-4">
                <h2 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">メモフィルター</h2>
                <div class="space-y-1">
                    <button data-notefilter="all" class="note-filter-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-note-sticky w-4"></i>すべてのメモ</span>
                        <span id="countAllNotes" class="text-xs opacity-80">0</span>
                    </button>
                    <button data-notefilter="pinned" class="note-filter-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-thumbtack w-4"></i>ピン留め済み</span>
                        <span id="countPinnedNotes" class="text-xs opacity-80">0</span>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Work Area -->
        <main class="flex-1 space-y-4 min-w-0">

            <!-- Search Bar & Controls -->
            <div class="flex flex-col sm:flex-row gap-3 items-center justify-between bg-white dark:bg-slate-800 p-3 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                <!-- Search Box -->
                <div class="relative w-full sm:w-72">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="searchInput" placeholder="検索（タスク・メモ名）..." class="w-full pl-9 pr-4 py-2 text-sm bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <!-- Sort & View Controls -->
                <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-2">
                    <span class="text-xs text-slate-500 dark:text-slate-400 hidden lg:inline">並び替え:</span>
                    <select id="sortSelect" class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 text-xs rounded-xl py-2 px-3 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        <option value="created-desc">作成日が新しい順</option>
                        <option value="due-asc">期日が近い順</option>
                        <option value="priority-desc">優先度が高い順</option>
                        <option value="title-asc">名前順 (A-Z)</option>
                    </select>
                </div>
            </div>

            <!-- TASK SECTION CONTAINER -->
            <section id="tasksSection" class="space-y-3">
                <!-- Task Progress Bar Card -->
                <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h2 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-chart-line text-emerald-500"></i>
                            <span id="currentFilterLabel">すべてのタスク</span>
                        </h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5" id="taskSummaryText">読み込み中...</p>
                    </div>
                    <div class="w-full sm:w-48 bg-slate-100 dark:bg-slate-700 h-2.5 rounded-full overflow-hidden">
                        <div id="mainProgressBar" class="bg-emerald-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Task List Box -->
                <div id="taskList" class="space-y-2.5">
                    <!-- Tasks inserted dynamically -->
                </div>

                <!-- Empty State for Tasks -->
                <div id="tasksEmptyState" class="hidden text-center py-12 px-4 bg-white dark:bg-slate-800 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700">
                    <div class="w-16 h-16 mx-auto mb-3 bg-emerald-50 dark:bg-emerald-900/30 rounded-2xl flex items-center justify-center text-emerald-500">
                        <i class="fa-regular fa-clipboard text-2xl"></i>
                    </div>
                    <h3 class="font-bold text-slate-700 dark:text-slate-200 mb-1">タスクがありません</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-xs mx-auto mb-4">新しいやることを登録して、効率的にタスクを進めましょう。</p>
                    <button onclick="document.getElementById('openAddTaskModalBtn').click()" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-4 py-2 rounded-xl transition">
                        <i class="fa-solid fa-plus"></i> タスクを作成
                    </button>
                </div>
            </section>

            <!-- MEMO SECTION CONTAINER (Hidden by default) -->
            <section id="notesSection" class="hidden space-y-3">
                <div id="notesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Memos inserted dynamically -->
                </div>

                <!-- Empty State for Notes -->
                <div id="notesEmptyState" class="hidden text-center py-12 px-4 bg-white dark:bg-slate-800 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700">
                    <div class="w-16 h-16 mx-auto mb-3 bg-amber-50 dark:bg-amber-900/30 rounded-2xl flex items-center justify-center text-amber-500">
                        <i class="fa-solid fa-lightbulb text-2xl"></i>
                    </div>
                    <h3 class="font-bold text-slate-700 dark:text-slate-200 mb-1">メモがありません</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-xs mx-auto mb-4">アイデアやちょっとした注意事項をメモ残しましょう。</p>
                    <button onclick="document.getElementById('openAddNoteModalBtn').click()" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-medium px-4 py-2 rounded-xl transition">
                        <i class="fa-solid fa-plus"></i> メモを作成
                    </button>
                </div>
            </section>

        </main>
    </div>

    <!-- MODAL: ADD / EDIT TASK -->
    <div id="taskModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 hidden fade-in">
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xl max-w-md w-full overflow-hidden max-h-[90vh] flex flex-col">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
                <h3 id="taskModalTitle" class="font-bold text-slate-800 dark:text-white text-base">新しいタスクを追加</h3>
                <button type="button" class="closeTaskModalBtn text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form id="taskForm" class="p-6 space-y-4 overflow-y-auto flex-1">
                <input type="hidden" id="taskId">

                <!-- Title -->
                <div>
                    <label for="taskTitle" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">タスク名 <span class="text-rose-500">*</span></label>
                    <input type="text" id="taskTitle" required placeholder="例: 企画書の作成、買い出し" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>

                <!-- Details / Memo -->
                <div>
                    <label for="taskDescription" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">詳細・メモ</label>
                    <textarea id="taskDescription" rows="3" placeholder="補足情報やリンクなど..." class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none"></textarea>
                </div>

                <!-- Priority & Category Grid -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="taskPriority" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">優先度</label>
                        <select id="taskPriority" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="high">高 (優先)</option>
                            <option value="medium" selected>中 (標準)</option>
                            <option value="low">低 (低優先)</option>
                        </select>
                    </div>
                    <div>
                        <label for="taskCategory" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">カテゴリ</label>
                        <select id="taskCategory" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="仕事">仕事</option>
                            <option value="プライベート">プライベート</option>
                            <option value="買い物">買い物</option>
                            <option value="学習">学習</option>
                            <option value="健康">健康</option>
                            <option value="その他">その他</option>
                        </select>
                    </div>
                </div>

                <!-- Due Date & Time -->
                <div>
                    <label for="taskDueDate" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">期限日</label>
                    <input type="date" id="taskDueDate" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>

                <!-- Subtasks Input -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">サブタスク（チェックリスト）</label>
                    <div id="subtasksInputContainer" class="space-y-2 mb-2">
                        <!-- Dynamic subtask inputs -->
                    </div>
                    <button type="button" id="addSubtaskBtn" class="text-xs text-emerald-600 dark:text-emerald-400 hover:underline font-medium flex items-center gap-1">
                        <i class="fa-solid fa-plus text-xs"></i> サブ項目を追加
                    </button>
                </div>

                <!-- Submit buttons -->
                <div class="pt-4 border-t border-slate-100 dark:border-slate-700 flex justify-end gap-2">
                    <button type="button" class="closeTaskModalBtn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                        キャンセル
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-medium bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-500/20 transition">
                        保存する
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: ADD / EDIT NOTE -->
    <div id="noteModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 hidden fade-in">
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xl max-w-md w-full overflow-hidden flex flex-col">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
                <h3 id="noteModalTitle" class="font-bold text-slate-800 dark:text-white text-base">新しいメモを追加</h3>
                <button type="button" class="closeNoteModalBtn text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form id="noteForm" class="p-6 space-y-4">
                <input type="hidden" id="noteId">

                <!-- Title -->
                <div>
                    <label for="noteTitle" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">タイトル <span class="text-rose-500">*</span></label>
                    <input type="text" id="noteTitle" required placeholder="例: 今週のアイデア、買いたいものリスト" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>

                <!-- Content -->
                <div>
                    <label for="noteContent" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">内容</label>
