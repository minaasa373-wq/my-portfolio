    <!-- CUSTOM TOAST NOTIFICATION CONTAINER -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script>
        // Render Category Filter Buttons
        function renderCategoryFilters() {
            const container = document.getElementById('categoryFilterContainer');
            const categories = ['仕事', 'プライベート', '買い物', '学習', '健康', 'その他'];

            let html = `
                <button data-cat="all" class="category-btn w-full flex items-center justify-between px-3 py-1.5 rounded-xl text-xs font-medium ${state.categoryFilter === 'all' ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50/50 dark:bg-emerald-900/20' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50'}">
                    <span>すべて</span>
                </button>
            `;

            categories.forEach(cat => {
                const isSelected = state.categoryFilter === cat;
                html += `
                    <button data-cat="${cat}" class="category-btn w-full flex items-center justify-between px-3 py-1.5 rounded-xl text-xs font-medium ${isSelected ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50/50 dark:bg-emerald-900/20 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50'}">
                        <span># ${cat}</span>
                    </button>
                `;
            });

            container.innerHTML = html;

            // Add event listeners
            container.querySelectorAll('.category-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    state.categoryFilter = btn.dataset.cat;
                    renderCategoryFilters();
                    renderTasks();
                });
            });
        }

        // Filter and Sort Tasks
        function getFilteredTasks() {
            const todayStr = new Date().toISOString().split('T')[0];

            return state.tasks.filter(task => {
                // Status Filter
                if (state.taskFilter === 'active' && task.completed) return false;
                if (state.taskFilter === 'completed' && !task.completed) return false;
                if (state.taskFilter === 'today' && task.dueDate !== todayStr) return false;

                // Category Filter
                if (state.categoryFilter !== 'all' && task.category !== state.categoryFilter) return false;

                // Search Query Filter
                if (state.searchQuery.trim() !== '') {
                    const q = state.searchQuery.toLowerCase();
                    const titleMatch = task.title.toLowerCase().includes(q);
                    const descMatch = (task.description || '').toLowerCase().includes(q);
                    if (!titleMatch && !descMatch) return false;
                }

                return true;
            }).sort((a, b) => {
                if (state.sortBy === 'due-asc') {
                    if (!a.dueDate) return 1;
                    if (!b.dueDate) return -1;
                    return new Date(a.dueDate) - new Date(b.dueDate);
                }
                if (state.sortBy === 'priority-desc') {
                    const pMap = { high: 3, medium: 2, low: 1 };
                    return pMap[b.priority] - pMap[a.priority];
                }
                if (state.sortBy === 'title-asc') {
                    return a.title.localeCompare(b.title, 'ja');
                }
                // default created-desc
                return new Date(b.createdAt) - new Date(a.createdAt);
            });
        }

        // Render Task List
        function renderTasks() {
            const taskList = document.getElementById('taskList');
            const emptyState = document.getElementById('tasksEmptyState');
            const filtered = getFilteredTasks();

            // Update Counters
            const total = state.tasks.length;
            const completedCount = state.tasks.filter(t => t.completed).length;
            const activeCount = total - completedCount;
            const todayStr = new Date().toISOString().split('T')[0];
            const todayCount = state.tasks.filter(t => t.dueDate === todayStr).length;

            document.getElementById('countAllTasks').textContent = total;
            document.getElementById('countActiveTasks').textContent = activeCount;
            document.getElementById('countTodayTasks').textContent = todayCount;
            document.getElementById('countCompletedTasks').textContent = completedCount;
            document.getElementById('activeTaskBadge').textContent = activeCount;

            // Overall Progress
            const progressPercent = total > 0 ? Math.round((completedCount / total) * 100) : 0;
            document.getElementById('headerProgressBar').style.width = `${progressPercent}%`;
            document.getElementById('headerProgressText').textContent = `${progressPercent}%`;
            document.getElementById('mainProgressBar').style.width = `${progressPercent}%`;

            // Filter Summary Title
            const labels = {
                all: 'すべてのタスク',
                active: '未完了のタスク',
                today: '今日が期限のタスク',
                completed: '完了済みのタスク'
            };
            document.getElementById('currentFilterLabel').textContent = labels[state.taskFilter] || 'タスク';
            document.getElementById('taskSummaryText').textContent = `全 ${filtered.length} 件表示中 （完了: ${completedCount} / ${total}）`;

            if (filtered.length === 0) {
                taskList.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            taskList.innerHTML = filtered.map(task => {
                const isOverdue = task.dueDate && task.dueDate < todayStr && !task.completed;
                const priorityBadges = {
                    high: '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300">優先: 高</span>',
                    medium: '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300">優先: 中</span>',
                    low: '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">優先: 低</span>'
                };

                const subtaskCompleted = task.subtasks ? task.subtasks.filter(s => s.completed).length : 0;
                const subtaskTotal = task.subtasks ? task.subtasks.length : 0;

                return `
                    <div class="bg-white dark:bg-slate-800 border ${task.completed ? 'border-slate-200 dark:border-slate-700/60 opacity-60' : 'border-slate-200 dark:border-slate-700'} rounded-2xl p-4 transition-all hover:shadow-md flex flex-col gap-3 group">
                        <div class="flex items-start justify-between gap-3">
                            <!-- Custom Checkbox & Task Title -->
                            <div class="flex items-start gap-3 min-w-0 flex-1">
                                <label class="relative flex items-center cursor-pointer mt-0.5 select-none">
                                    <input type="checkbox" ${task.completed ? 'checked' : ''} onchange="toggleTaskStatus('${task.id}')" class="sr-only task-checkbox">
                                    <div class="checkbox-custom w-5 h-5 rounded-lg border-2 border-slate-300 dark:border-slate-600 flex items-center justify-center text-white transition-all">
                                        <i class="fa-solid fa-check text-xs hidden"></i>
                                    </div>
                                </label>

                                <div class="min-w-0 flex-1">
                                    <h3 class="font-medium text-sm text-slate-800 dark:text-slate-100 leading-snug ${task.completed ? 'line-through text-slate-400 dark:text-slate-500' : ''}">
                                        ${escapeHtml(task.title)}
                                    </h3>
                                    ${task.description ? `<p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">${escapeHtml(task.description)}</p>` : ''}
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="flex items-center gap-1 opacity-90 sm:opacity-0 group-hover:opacity-100 transition">
                                <button onclick="editTask('${task.id}')" title="編集" class="p-1.5 rounded-lg text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 transition text-xs">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button onclick="deleteTask('${task.id}')" title="削除" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-900/30 transition text-xs">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Subtasks Progress List if any -->
                        ${subtaskTotal > 0 ? `
                            <div class="bg-slate-50 dark:bg-slate-900/50 p-2.5 rounded-xl space-y-1.5 text-xs border border-slate-100 dark:border-slate-700/50">
                                <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 mb-1">
                                    <span>チェックリスト</span>
                                    <span>${subtaskCompleted} / ${subtaskTotal}</span>
                                </div>
                                ${task.subtasks.map(sub => `
                                    <label class="flex items-center gap-2 cursor-pointer select-none">
                                        <input type="checkbox" ${sub.completed ? 'checked' : ''} onchange="toggleSubtask('${task.id}', '${sub.id}')" class="rounded text-emerald-600 focus:ring-emerald-500 w-3.5 h-3.5">
                                        <span class="${sub.completed ? 'line-through text-slate-400' : 'text-slate-700 dark:text-slate-300'}">${escapeHtml(sub.title)}</span>
                                    </label>
                                `).join('')}
                            </div>
                        ` : ''}

                        <!-- Meta Info Footer -->
                        <div class="flex flex-wrap items-center gap-2 pt-1 text-[11px] text-slate-500 dark:text-slate-400">
                            ${priorityBadges[task.priority]}
                            <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300"># ${escapeHtml(task.category)}</span>
                            
                            ${task.dueDate ? `
                                <span class="flex items-center gap-1 ${isOverdue ? 'text-rose-600 dark:text-rose-400 font-semibold' : ''}">
                                    <i class="fa-regular fa-calendar text-[10px]"></i>
                                    ${task.dueDate} ${isOverdue ? '(期限切れ)' : ''}
                                </span>
                            ` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Render Memos Section
        function renderNotes() {
            const notesGrid = document.getElementById('notesGrid');
            const emptyState = document.getElementById('notesEmptyState');

            let filtered = state.notes.filter(note => {
                if (state.noteFilter === 'pinned' && !note.pinned) return false;
                if (state.searchQuery.trim() !== '') {
                    const q = state.searchQuery.toLowerCase();
                    const tMatch = note.title.toLowerCase().includes(q);
                    const cMatch = (note.content || '').toLowerCase().includes(q);
                    if (!tMatch && !cMatch) return false;
                }
                return true;
            });

            // Always pinned first, then date desc
            filtered.sort((a, b) => {
                if (a.pinned !== b.pinned) return b.pinned ? 1 : -1;
                return new Date(b.createdAt) - new Date(a.createdAt);
            });

            // Counters
            document.getElementById('countAllNotes').textContent = state.notes.length;
            document.getElementById('countPinnedNotes').textContent = state.notes.filter(n => n.pinned).length;
            document.getElementById('activeNoteBadge').textContent = state.notes.length;

            if (filtered.length === 0) {
                notesGrid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            const colorClasses = {
                yellow: 'bg-amber-50 dark:bg-amber-950/20 border-amber-200 dark:border-amber-800/50',
                blue: 'bg-blue-50 dark:bg-blue-950/20 border-blue-200 dark:border-blue-800/50',
                emerald: 'bg-emerald-50 dark:bg-emerald-950/20 border-emerald-200 dark:border-emerald-800/50',
                purple: 'bg-purple-50 dark:bg-purple-950/20 border-purple-200 dark:border-purple-800/50',
                rose: 'bg-rose-50 dark:bg-rose-950/20 border-rose-200 dark:border-rose-800/50'
            };

            notesGrid.innerHTML = filtered.map(note => `
                <div class="rounded-2xl border p-4 flex flex-col justify-between gap-3 shadow-sm transition hover:shadow-md ${colorClasses[note.color] || colorClasses.yellow} relative group">
                    <div class="space-y-2">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center gap-1.5">
                                ${escapeHtml(note.title)}
                            </h3>
                            <button onclick="toggleNotePin('${note.id}')" title="${note.pinned ? 'ピン解除' : 'トップに固定'}" class="text-xs p-1 ${note.pinned ? 'text-amber-500' : 'text-slate-400 hover:text-slate-600 dark:hover:text-slate-200'}">
                                <i class="fa-solid fa-thumbtack"></i>
                            </button>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">${escapeHtml(note.content)}</p>
                    </div>

                    <div class="flex items-center justify-between pt-2 border-t border-black/5 dark:border-white/5 text-[11px] text-slate-400">
                        <span>${new Date(note.createdAt).toLocaleDateString('ja-JP')}</span>
                        <div class="flex items-center gap-1 opacity-90 sm:opacity-0 group-hover:opacity-100 transition">
                            <button onclick="editNote('${note.id}')" title="編集" class="p-1 rounded hover:text-blue-600 transition">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="deleteNote('${note.id}')" title="削除" class="p-1 rounded hover:text-rose-600 transition">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Toggle Task Status
        window.toggleTaskStatus = function(taskId) {
            const task = state.tasks.find(t => t.id === taskId);
            if (task) {
                task.completed = !task.completed;
                saveData();
                renderTasks();
                showToast(task.completed ? 'タスクを完了にしました！' : 'タスクを未完了に戻しました', 'success');
            }
        };

        // Toggle Subtask
        window.toggleSubtask = function(taskId, subId) {
            const task = state.tasks.find(t => t.id === taskId);
            if (task && task.subtasks) {
                const sub = task.subtasks.find(s => s.id === subId);
                if (sub) {
                    sub.completed = !sub.completed;
                    saveData();
                    renderTasks();
                }
            }
        };

        // Delete Task
        window.deleteTask = function(taskId) {
            state.tasks = state.tasks.filter(t => t.id !== taskId);
            saveData();
            renderTasks();
            showToast('タスクを削除しました');
        };

        // Edit Task Modal Open
        window.editTask = function(taskId) {
            const task = state.tasks.find(t => t.id === taskId);
            if (!task) return;

            document.getElementById('taskId').value = task.id;
            document.getElementById('taskTitle').value = task.title;
            document.getElementById('taskDescription').value = task.description || '';
            document.getElementById('taskPriority').value = task.priority;
            document.getElementById('taskCategory').value = task.category;
            document.getElementById('taskDueDate').value = task.dueDate || '';

            // Subtasks populate
            const container = document.getElementById('subtasksInputContainer');
            container.innerHTML = '';
            if (task.subtasks) {
                task.subtasks.forEach(sub => addSubtaskInputField(sub.title, sub.completed));
            }

            document.getElementById('taskModalTitle').textContent = 'タスクの編集';
            document.getElementById('taskModal').classList.remove('hidden');
        };

        // Add Subtask input row to modal
        function addSubtaskInputField(title = '', completed = false) {
            const container = document.getElementById('subtasksInputContainer');
            const row = document.createElement('div');
            row.className = 'flex items-center gap-2 subtask-row';
            row.innerHTML = `
                <input type="checkbox" ${completed ? 'checked' : ''} class="subtask-input-checkbox rounded text-emerald-600 focus:ring-emerald-500">
                <input type="text" value="${escapeHtml(title)}" placeholder="サブタスク内容..." class="subtask-input-text flex-1 px-2.5 py-1 text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg">
                <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-rose-500 p-1 text-xs">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            `;
            container.appendChild(row);
        }

        document.getElementById('addSubtaskBtn').addEventListener('click', () => {
            addSubtaskInputField();
        });

        // Task Form Submit
        document.getElementById('taskForm').addEventListener('submit', (e) => {
            e.preventDefault();

            const taskId = document.getElementById('taskId').value;
            const title = document.getElementById('taskTitle').value.trim();
            const description = document.getElementById('taskDescription').value.trim();
            const priority = document.getElementById('taskPriority').value;
            const category = document.getElementById('taskCategory').value;
            const dueDate = document.getElementById('taskDueDate').value;

            // Gather subtasks
            const subtaskRows = document.querySelectorAll('.subtask-row');
            const subtasks = [];
            subtaskRows.forEach((row, idx) => {
                const subTitle = row.querySelector('.subtask-input-text').value.trim();
                const isChecked = row.querySelector('.subtask-input-checkbox').checked;
                if (subTitle) {
                    subtasks.push({
                        id: 'sub-' + Date.now() + '-' + idx,
                        title: subTitle,
                        completed: isChecked
                    });
                }
            });

            if (taskId) {
                // Update
                const task = state.tasks.find(t => t.id === taskId);
                if (task) {
                    task.title = title;
                    task.description = description;
                    task.priority = priority;
                    task.category = category;
                    task.dueDate = dueDate;
                    task.subtasks = subtasks;
                }
                showToast('タスクを更新しました', 'success');
            } else {
                // Create
                const newTask = {
                    id: 'task-' + Date.now(),
                    title,
                    description,
                    priority,
                    category,
                    dueDate,
                    completed: false,
                    subtasks,
                    createdAt: new Date().toISOString()
                };
                state.tasks.unshift(newTask);
                showToast('新しいタスクを追加しました', 'success');
            }

            saveData();
            renderTasks();
            closeTaskModal();
        });

        function closeTaskModal() {
            document.getElementById('taskModal').classList.add('hidden');
            document.getElementById('taskForm').reset();
            document.getElementById('taskId').value = '';
            document.getElementById('subtasksInputContainer').innerHTML = '';
        }

        document.querySelectorAll('.closeTaskModalBtn').forEach(btn => {
            btn.addEventListener('click', closeTaskModal);
        });

        document.getElementById('openAddTaskModalBtn').addEventListener('click', () => {
            document.getElementById('taskModalTitle').textContent = '新しいタスクを追加';
            document.getElementById('taskForm').reset();
            document.getElementById('taskId').value = '';
            document.getElementById('subtasksInputContainer').innerHTML = '';
            document.getElementById('taskModal').classList.remove('hidden');
        });

        // Note Actions
        window.toggleNotePin = function(noteId) {
            const note = state.notes.find(n => n.id === noteId);
            if (note) {
                note.pinned = !note.pinned;
                saveData();
                renderNotes();
            }
        };

        window.deleteNote = function(noteId) {
            state.notes = state.notes.filter(n => n.id !== noteId);
            saveData();
            renderNotes();
            showToast('メモを削除しました');
        };

        window.editNote = function(noteId) {
            const note = state.notes.find(n => n.id === noteId);
            if (!note) return;

            document.getElementById('noteId').value = note.id;
            document.getElementById('noteTitle').value = note.title;
            document.getElementById('noteContent').value = note.content || '';
            document.getElementById('notePinned').checked = note.pinned || false;

            const colorRadios = document.querySelectorAll('input[name="noteColor"]');
            colorRadios.forEach(radio => {
                radio.checked = radio.value === note.color;
            });

            document.getElementById('noteModalTitle').textContent = 'メモを編集';
            document.getElementById('noteModal').classList.remove('hidden');
        };

        document.getElementById('noteForm').addEventListener('submit', (e) => {
            e.preventDefault();

            const noteId = document.getElementById('noteId').value;
            const title = document.getElementById('noteTitle').value.trim();
            const content = document.getElementById('noteContent').value.trim();
            const pinned = document.getElementById('notePinned').checked;
            const color = document.querySelector('input[name="noteColor"]:checked').value;

            if (noteId) {
                const note = state.notes.find(n => n.id === noteId);
                if (note) {
                    note.title = title;
                    note.content = content;
                    note.pinned = pinned;
                    note.color = color;
                }
                showToast('メモを更新しました', 'success');
            } else {
                const newNote = {
                    id: 'note-' + Date.now(),
                    title,
                    content,
                    pinned,
                    color,
                    createdAt: new Date().toISOString()
                };
                state.notes.unshift(newNote);
                showToast('新しいメモを追加しました', 'success');
            }

            saveData();
            renderNotes();
            closeNoteModal();
        });

        function closeNoteModal() {
            document.getElementById('noteModal').classList.add('hidden');
            document.getElementById('noteForm').reset();
            document.getElementById('noteId').value = '';
        }

        document.querySelectorAll('.closeNoteModalBtn').forEach(btn => {
            btn.addEventListener('click', closeNoteModal);
        });

        document.getElementById('openAddNoteModalBtn').addEventListener('click', () => {
            document.getElementById('noteModalTitle').textContent = '新しいメモを追加';
            document.getElementById('noteForm').reset();
            document.getElementById('noteId').value = '';
            document.getElementById('noteModal').classList.remove('hidden');
        });

        // Tab Switcher Logic
        const viewTasksTab = document.getElementById('viewTasksTab');
        const viewNotesTab = document.getElementById('viewNotesTab');
        const tasksSection = document.getElementById('tasksSection');
        const notesSection = document.getElementById('notesSection');
        const taskFiltersSidebar = document.getElementById('taskFiltersSidebar');
        const noteFiltersSidebar = document.getElementById('noteFiltersSidebar');

        viewTasksTab.addEventListener('click', () => {
            state.currentTab = 'tasks';
            viewTasksTab.className = "flex-1 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition bg-emerald-600 text-white shadow-sm";
            viewNotesTab.className = "flex-1 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white";
            
            tasksSection.classList.remove('hidden');
            notesSection.classList.add('hidden');
            taskFiltersSidebar.classList.remove('hidden');
            noteFiltersSidebar.classList.add('hidden');
        });

        viewNotesTab.addEventListener('click', () => {
            state.currentTab = 'notes';
            viewNotesTab.className = "flex-1 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition bg-emerald-600 text-white shadow-sm";
            viewTasksTab.className = "flex-1 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white";
            
            notesSection.classList.remove('hidden');
            tasksSection.classList.add('hidden');
            noteFiltersSidebar.classList.remove('hidden');
            taskFiltersSidebar.classList.add('hidden');
        });

        // Filter Buttons Listeners
        document.querySelectorAll('.task-status-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.task-status-btn').forEach(b => {
                    b.className = "task-status-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50";
                });
                btn.className = "task-status-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30";
                state.taskFilter = btn.dataset.filter;
                renderTasks();
            });
        });

        document.querySelectorAll('.note-filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.note-filter-btn').forEach(b => {
                    b.className = "note-filter-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50";
                });
                btn.className = "note-filter-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30";
                state.noteFilter = btn.dataset.notefilter;
                renderNotes();
            });
        });

        // Search & Sort Inputs
        document.getElementById('searchInput').addEventListener('input', (e) => {
            state.searchQuery = e.target.value;
            renderTasks();
            renderNotes();
        });

        document.getElementById('sortSelect').addEventListener('change', (e) => {
            state.sortBy = e.target.value;
            renderTasks();
        });

        // Dark Mode Toggle
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        themeToggleBtn.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('donote_theme', isDark ? 'dark' : 'light');
        });

        // Load theme preference
        if (localStorage.getItem('donote_theme') === 'dark' || (!('donote_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        // Settings Modal Controls
        const settingsModal = document.getElementById('settingsModal');
        document.getElementById('openSettingsBtn').addEventListener('click', () => {
            settingsModal.classList.remove('hidden');
        });

        document.getElementById('closeSettingsModalBtn').addEventListener('click', () => {
            settingsModal.classList.add('hidden');
        });

        // Export JSON Data
        document.getElementById('exportDataBtn').addEventListener('click', () => {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `donote_backup_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast('データをファイルに保存しました', 'success');
        });

        // Import JSON Data
        document.getElementById('importFileInput').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(event) {
                try {
                    const parsed = JSON.parse(event.target.result);
                    if (parsed.tasks && parsed.notes) {
                        state.tasks = parsed.tasks;
                        state.notes = parsed.notes;
                        saveData();
                        renderCategoryFilters();
                        renderTasks();
                        renderNotes();
                        settingsModal.classList.add('hidden');
                        showToast('データを復元しました', 'success');
                    } else {
                        showToast('無効なバックアップファイルです', 'error');
                    }
                } catch (err) {
                    showToast('ファイルの読み込みに失敗しました', 'error');
                }
            };
            reader.readAsText(file);
        });

        // Clear All Data
        document.getElementById('clearAllDataBtn').addEventListener('click', () => {
            if (window.confirm('すべてのタスクとメモを消去してもよろしいですか？（元に戻せません）')) {
                state.tasks = [];
                state.notes = [];
                saveData();
                renderTasks();
                renderNotes();
                settingsModal.classList.add('hidden');
                showToast('データをリセットしました');
            }
        });

        // App Initializer
        window.onload = function() {
            loadData();
            renderCategoryFilters();
            renderTasks();
            renderNotes();
        };
    </script>
</body>
</html>
